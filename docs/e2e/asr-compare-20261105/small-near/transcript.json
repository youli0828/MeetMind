{
  "language": "zh",
  "segments": [
    {
      "id": 0,
      "start": 6.58,
      "end": 11.08,
      "text": "今天咱们公司新出了一款手机产品",
      "speaker": null
    },
    {
      "id": 1,
      "start": 11.08,
      "end": 13.08,
      "text": "进行一下研讨会",
      "speaker": null
    },
    {
      "id": 2,
      "start": 13.08,
      "end": 17.58,
      "text": "首先咱们确定一下咱们产品的目标人群",
      "speaker": null
    },
    {
      "id": 3,
      "start": 17.58,
      "end": 18.58,
      "text": "客户群这一块",
      "speaker": null
    },
    {
      "id": 4,
      "start": 18.58,
      "end": 21.08,
      "text": "首先谈一下咱们大家伙的一个看法",
      "speaker": null
    },
    {
      "id": 5,
      "start": 21.08,
      "end": 24.58,
      "text": "先谈一下吧",
      "speaker": null
    },
    {
      "id": 6,
      "start": 24.58,
      "end": 27.58,
      "text": "我觉得咱们这个目标人群",
      "speaker": null
    },
    {
      "id": 7,
      "start": 27.58,
      "end": 29.58,
      "text": "可以不用定的那么确定",
      "speaker": null
    },
    {
      "id": 8,
      "start": 29.58,
      "end": 33.08,
      "text": "然后基本上就是让它什么类的人群",
      "speaker": null
    },
    {
      "id": 9,
      "start": 33.08,
      "end": 34.08,
      "text": "然后都可以",
      "speaker": null
    },
    {
      "id": 10,
      "start": 34.08,
      "end": 36.58,
      "text": "这样咱们的面比较广",
      "speaker": null
    },
    {
      "id": 11,
      "start": 36.58,
      "end": 37.58,
      "text": "因为咱们这个手机",
      "speaker": null
    },
    {
      "id": 12,
      "start": 37.58,
      "end": 40.58,
      "text": "现在基本上外观设计得比较时尚",
      "speaker": null
    },
    {
      "id": 13,
      "start": 40.58,
      "end": 42.58,
      "text": "所以我觉得其实不用界定",
      "speaker": null
    },
    {
      "id": 14,
      "start": 42.58,
      "end": 45.08,
      "text": "于这个老年人或者年轻人之间",
      "speaker": null
    },
    {
      "id": 15,
      "start": 45.08,
      "end": 46.58,
      "text": "这夸多大一点是吧",
      "speaker": null
    },
    {
      "id": 16,
      "start": 46.58,
      "end": 48.58,
      "text": "对 这样我觉得范围更广一些",
      "speaker": null
    },
    {
      "id": 17,
      "start": 48.58,
      "end": 51.58,
      "text": "就是什么样的人群都可以选择",
      "speaker": null
    },
    {
      "id": 18,
      "start": 51.58,
      "end": 54.58,
      "text": "我觉得是要有针对性的",
      "speaker": null
    },
    {
      "id": 19,
      "start": 54.58,
      "end": 58.08,
      "text": "我觉得咱们的设计外观还是很时尚",
      "speaker": null
    },
    {
      "id": 20,
      "start": 58.08,
      "end": 61.58,
      "text": "还是需要去设定一下",
      "speaker": null
    },
    {
      "id": 21,
      "start": 61.58,
      "end": 64.58,
      "text": "比较适合的年龄段",
      "speaker": null
    },
    {
      "id": 22,
      "start": 64.58,
      "end": 66.58,
      "text": "比方说因为它是幽彩色的",
      "speaker": null
    },
    {
      "id": 23,
      "start": 66.58,
      "end": 67.58,
      "text": "有蓝色的黄色",
      "speaker": null
    },
    {
      "id": 24,
      "start": 67.58,
      "end": 69.58,
      "text": "年老年人它不可能用这种颜色",
      "speaker": null
    },
    {
      "id": 25,
      "start": 69.58,
      "end": 71.58,
      "text": "也可以说是有一种反弹",
      "speaker": null
    },
    {
      "id": 26,
      "start": 71.58,
      "end": 73.58,
      "text": "对 而且你现在设计的产品",
      "speaker": null
    },
    {
      "id": 27,
      "start": 73.58,
      "end": 76.58,
      "text": "主要推出的是它有照相的功能",
      "speaker": null
    },
    {
      "id": 28,
      "start": 76.58,
      "end": 79.58,
      "text": "功能的话是很好",
      "speaker": null
    },
    {
      "id": 29,
      "start": 79.58,
      "end": 83.58,
      "text": "所以还是适合年轻的人群",
      "speaker": null
    },
    {
      "id": 30,
      "start": 83.58,
      "end": 85.58,
      "text": "我感觉可以根据年龄",
      "speaker": null
    },
    {
      "id": 31,
      "start": 85.58,
      "end": 89.58,
      "text": "和这种不同的人士作一下区分",
      "speaker": null
    },
    {
      "id": 32,
      "start": 90.58,
      "end": 91.58,
      "text": "我感觉我们可以说",
      "speaker": null
    },
    {
      "id": 33,
      "start": 91.58,
      "end": 97.58,
      "text": "真的就是18到45岁的中青年人群",
      "speaker": null
    },
    {
      "id": 34,
      "start": 97.58,
      "end": 98.58,
      "text": "首先咱们就确定说",
      "speaker": null
    },
    {
      "id": 35,
      "start": 98.58,
      "end": 100.58,
      "text": "手机从特点来说",
      "speaker": null
    },
    {
      "id": 36,
      "start": 100.58,
      "end": 103.58,
      "text": "可能年龄段要夸多大一点",
      "speaker": null
    },
    {
      "id": 37,
      "start": 103.58,
      "end": 104.58,
      "text": "但是我觉得",
      "speaker": null
    },
    {
      "id": 38,
      "start": 104.58,
      "end": 107.58,
      "text": "现在老年人也都很时尚",
      "speaker": null
    },
    {
      "id": 39,
      "start": 107.58,
      "end": 108.58,
      "text": "你看现在老年人出去",
      "speaker": null
    },
    {
      "id": 40,
      "start": 108.58,
      "end": 110.58,
      "text": "他基本上把自己装束的",
      "speaker": null
    },
    {
      "id": 41,
      "start": 110.58,
      "end": 112.58,
      "text": "都是大粉大红",
      "speaker": null
    },
    {
      "id": 42,
      "start": 112.58,
      "end": 114.58,
      "text": "他很喜欢特别亮的颜色",
      "speaker": null
    },
    {
      "id": 43,
      "start": 114.58,
      "end": 115.58,
      "text": "年轻感",
      "speaker": null
    },
    {
      "id": 44,
      "start": 115.58,
      "end": 116.58,
      "text": "年轻吧 是吧",
      "speaker": null
    },
    {
      "id": 45,
      "start": 116.58,
      "end": 119.58,
      "text": "但是现在的这个版本的话",
      "speaker": null
    },
    {
      "id": 46,
      "start": 119.58,
      "end": 120.58,
      "text": "它是不适合老年人的",
      "speaker": null
    },
    {
      "id": 47,
      "start": 120.58,
      "end": 121.58,
      "text": "你有一些功能",
      "speaker": null
    },
    {
      "id": 48,
      "start": 121.58,
      "end": 122.58,
      "text": "像老年人的话",
      "speaker": null
    },
    {
      "id": 49,
      "start": 122.58,
      "end": 124.58,
      "text": "它需要很多的大字体",
      "speaker": null
    },
    {
      "id": 50,
      "start": 124.58,
      "end": 127.58,
      "text": "或者是一些网络上的东西",
      "speaker": null
    },
    {
      "id": 51,
      "start": 127.58,
      "end": 129.58,
      "text": "老年人根本就不懂",
      "speaker": null
    },
    {
      "id": 52,
      "start": 129.58,
      "end": 130.58,
      "text": "它操作不了",
      "speaker": null
    },
    {
      "id": 53,
      "start": 130.58,
      "end": 133.58,
      "text": "对 它那个规格还是不一样的",
      "speaker": null
    },
    {
      "id": 54,
      "start": 133.58,
      "end": 134.58,
      "text": "但是我觉得",
      "speaker": null
    },
    {
      "id": 55,
      "start": 134.58,
      "end": 135.58,
      "text": "这个手机里边的",
      "speaker": null
    },
    {
      "id": 56,
      "start": 135.58,
      "end": 137.58,
      "text": "很多这个字的东西",
      "speaker": null
    },
    {
      "id": 57,
      "start": 137.58,
      "end": 139.58,
      "text": "都是可以再去设的",
      "speaker": null
    },
    {
      "id": 58,
      "start": 139.58,
      "end": 141.58,
      "text": "而且我觉得现在",
      "speaker": null
    },
    {
      "id": 59,
      "start": 141.58,
      "end": 142.58,
      "text": "老年人也不是",
      "speaker": null
    },
    {
      "id": 60,
      "start": 142.58,
      "end": 144.58,
      "text": "所有的老年人都是那种",
      "speaker": null
    },
    {
      "id": 61,
      "start": 144.58,
      "end": 145.58,
      "text": "就是眼花",
      "speaker": null
    },
    {
      "id": 62,
      "start": 145.58,
      "end": 147.58,
      "text": "或者什么什么的情况",
      "speaker": null
    },
    {
      "id": 63,
      "start": 147.58,
      "end": 148.58,
      "text": "所以我觉得吧",
      "speaker": null
    },
    {
      "id": 64,
      "start": 148.58,
      "end": 151.58,
      "text": "就是不用把这个界线弄得那么分明",
      "speaker": null
    },
    {
      "id": 65,
      "start": 151.58,
      "end": 152.58,
      "text": "然后基本上能适应他",
      "speaker": null
    },
    {
      "id": 66,
      "start": 152.58,
      "end": 155.58,
      "text": "然后能去使用他的老年人",
      "speaker": null
    },
    {
      "id": 67,
      "start": 155.58,
      "end": 156.58,
      "text": "都还可以选择",
      "speaker": null
    },
    {
      "id": 68,
      "start": 156.58,
      "end": 158.58,
      "text": "但是我觉得还是有针对性的好",
      "speaker": null
    },
    {
      "id": 69,
      "start": 158.58,
      "end": 160.58,
      "text": "你现在买手机的话",
      "speaker": null
    },
    {
      "id": 70,
      "start": 160.58,
      "end": 161.58,
      "text": "它不一定都是说",
      "speaker": null
    },
    {
      "id": 71,
      "start": 161.58,
      "end": 162.58,
      "text": "老年人自己去买",
      "speaker": null
    },
    {
      "id": 72,
      "start": 162.58,
      "end": 163.58,
      "text": "老年人根本就不会看",
      "speaker": null
    },
    {
      "id": 73,
      "start": 163.58,
      "end": 166.58,
      "text": "一般都是子女给家长去买",
      "speaker": null
    },
    {
      "id": 74,
      "start": 166.58,
      "end": 168.58,
      "text": "它会观察里面的一些功能",
      "speaker": null
    },
    {
      "id": 75,
      "start": 168.58,
      "end": 169.58,
      "text": "什么的",
      "speaker": null
    },
    {
      "id": 76,
      "start": 169.58,
      "end": 171.58,
      "text": "会去选择",
      "speaker": null
    },
    {
      "id": 77,
      "start": 172.58,
      "end": 173.58,
      "text": "我感觉我们可以根据",
      "speaker": null
    },
    {
      "id": 78,
      "start": 173.58,
      "end": 174.58,
      "text": "就是不拖人群",
      "speaker": null
    },
    {
      "id": 79,
      "start": 174.58,
      "end": 176.58,
      "text": "稍微做一下差别设计",
      "speaker": null
    },
    {
      "id": 80,
      "start": 176.58,
      "end": 177.58,
      "text": "像如果老年人用的话",
      "speaker": null
    },
    {
      "id": 81,
      "start": 177.58,
      "end": 179.58,
      "text": "可以就是屁肢稍微低点",
      "speaker": null
    },
    {
      "id": 82,
      "start": 179.58,
      "end": 181.58,
      "text": "自己或者声音稍微大一点",
      "speaker": null
    },
    {
      "id": 83,
      "start": 181.58,
      "end": 182.58,
      "text": "年轻人用的话",
      "speaker": null
    },
    {
      "id": 84,
      "start": 182.58,
      "end": 184.58,
      "text": "就可能颜色选择性多点",
      "speaker": null
    },
    {
      "id": 85,
      "start": 184.58,
      "end": 185.58,
      "text": "屁肢是高点这种",
      "speaker": null
    },
    {
      "id": 86,
      "start": 185.58,
      "end": 187.58,
      "text": "好 所以可以",
      "speaker": null
    },
    {
      "id": 87,
      "start": 187.58,
      "end": 191.58,
      "text": "反正这个就是跨度反正就",
      "speaker": null
    },
    {
      "id": 88,
      "start": 191.58,
      "end": 192.58,
      "text": "不用特别大",
      "speaker": null
    },
    {
      "id": 89,
      "start": 192.58,
      "end": 193.58,
      "text": "从年轻人来说",
      "speaker": null
    },
    {
      "id": 90,
      "start": 193.58,
      "end": 195.58,
      "text": "咱主持着年轻跨这块吧",
      "speaker": null
    },
    {
      "id": 91,
      "start": 195.58,
      "end": 196.58,
      "text": "年轻人一块",
      "speaker": null
    },
    {
      "id": 92,
      "start": 196.58,
      "end": 199.58,
      "text": "我们18到35岁之间",
      "speaker": null
    },
    {
      "id": 93,
      "start": 199.58,
      "end": 200.58,
      "text": "大家一会儿觉得可以",
      "speaker": null
    },
    {
      "id": 94,
      "start": 200.58,
      "end": 202.58,
      "text": "45岁之间都可以 对吧",
      "speaker": null
    },
    {
      "id": 95,
      "start": 202.58,
      "end": 203.58,
      "text": "对",
      "speaker": null
    },
    {
      "id": 96,
      "start": 203.58,
      "end": 205.58,
      "text": "咱们机型我觉得还是适应",
      "speaker": null
    },
    {
      "id": 97,
      "start": 205.58,
      "end": 207.58,
      "text": "比较年轻化一点的",
      "speaker": null
    },
    {
      "id": 98,
      "start": 209.58,
      "end": 212.58,
      "text": "咱们后续再定一下",
      "speaker": null
    },
    {
      "id": 99,
      "start": 213.58,
      "end": 215.58,
      "text": "18到5岁之间的色彩颜色",
      "speaker": null
    },
    {
      "id": 100,
      "start": 215.58,
      "end": 217.58,
      "text": "咱们到时候确定一下颜色",
      "speaker": null
    },
    {
      "id": 101,
      "start": 218.58,
      "end": 221.58,
      "text": "首先咱们说粗糙方式这一块",
      "speaker": null
    },
    {
      "id": 102,
      "start": 221.58,
      "end": 223.58,
      "text": "咱们觉得以什么样的粗糙方式",
      "speaker": null
    },
    {
      "id": 103,
      "start": 223.58,
      "end": 226.58,
      "text": "进行粗销毁军的好一些",
      "speaker": null
    },
    {
      "id": 104,
      "start": 226.58,
      "end": 227.58,
      "text": "我们现在可以通过",
      "speaker": null
    },
    {
      "id": 105,
      "start": 227.58,
      "end": 229.58,
      "text": "比较热门的直播带货",
      "speaker": null
    },
    {
      "id": 106,
      "start": 229.58,
      "end": 232.58,
      "text": "然后不是忙了就电商双十一亩",
      "speaker": null
    },
    {
      "id": 107,
      "start": 232.58,
      "end": 235.58,
      "text": "这种活动我们都可以多参与一下",
      "speaker": null
    },
    {
      "id": 108,
      "start": 235.58,
      "end": 236.58,
      "text": "各大电商平台什么的",
      "speaker": null
    },
    {
      "id": 109,
      "start": 236.58,
      "end": 239.58,
      "text": "天猫 苏宁 淘宝 拼多多",
      "speaker": null
    },
    {
      "id": 110,
      "start": 239.58,
      "end": 240.58,
      "text": "会不会有压力",
      "speaker": null
    },
    {
      "id": 111,
      "start": 240.58,
      "end": 242.58,
      "text": "方式一的时候会不会有压力",
      "speaker": null
    },
    {
      "id": 112,
      "start": 242.58,
      "end": 244.58,
      "text": "我们前期主要是",
      "speaker": null
    },
    {
      "id": 113,
      "start": 244.58,
      "end": 247.58,
      "text": "价钱可以让利息",
      "speaker": null
    },
    {
      "id": 114,
      "start": 247.58,
      "end": 248.58,
      "text": "多占领一些市场份额",
      "speaker": null
    },
    {
      "id": 115,
      "start": 248.58,
      "end": 251.58,
      "text": "等市场份额慢慢做好之后",
      "speaker": null
    },
    {
      "id": 116,
      "start": 251.58,
      "end": 253.58,
      "text": "就可以价钱稍微高点",
      "speaker": null
    },
    {
      "id": 117,
      "start": 253.58,
      "end": 254.58,
      "text": "你没有什么方式",
      "speaker": null
    },
    {
      "id": 118,
      "start": 254.58,
      "end": 256.58,
      "text": "我觉得还是先要看一下",
      "speaker": null
    },
    {
      "id": 119,
      "start": 256.58,
      "end": 258.58,
      "text": "推出一下手机的亮点",
      "speaker": null
    },
    {
      "id": 120,
      "start": 258.58,
      "end": 261.58,
      "text": "它有什么和其他的手机",
      "speaker": null
    },
    {
      "id": 121,
      "start": 261.58,
      "end": 262.58,
      "text": "有什么不同的地方",
      "speaker": null
    },
    {
      "id": 122,
      "start": 262.58,
      "end": 267.58,
      "text": "然后再一些电商",
      "speaker": null
    },
    {
      "id": 123,
      "start": 267.58,
      "end": 268.58,
      "text": "给一些力度",
      "speaker": null
    },
    {
      "id": 124,
      "start": 268.58,
      "end": 270.58,
      "text": "比方说京东啊什么的",
      "speaker": null
    },
    {
      "id": 125,
      "start": 270.58,
      "end": 271.58,
      "text": "给一个折扣",
      "speaker": null
    },
    {
      "id": 126,
      "start": 271.58,
      "end": 272.58,
      "text": "但是有看有什么样的方式",
      "speaker": null
    },
    {
      "id": 127,
      "start": 272.58,
      "end": 275.58,
      "text": "去进行粗销",
      "speaker": null
    },
    {
      "id": 128,
      "start": 275.58,
      "end": 277.58,
