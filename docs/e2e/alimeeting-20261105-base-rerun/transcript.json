{
  "language": "zh",
  "segments": [
    {
      "id": 0,
      "start": 6.86,
      "end": 10.7,
      "text": "今天就是能夠自信出現新規管理的主席",
      "speaker": null
    },
    {
      "id": 1,
      "start": 10.7,
      "end": 13.18,
      "text": "採訪一下今天一家編號會",
      "speaker": null
    },
    {
      "id": 2,
      "start": 13.18,
      "end": 14.84,
      "text": "我再讓大家去看一下",
      "speaker": null
    },
    {
      "id": 3,
      "start": 14.84,
      "end": 17.5,
      "text": "採訪的目標的一個人群",
      "speaker": null
    },
    {
      "id": 4,
      "start": 17.5,
      "end": 18.76,
      "text": "科學那一塊",
      "speaker": null
    },
    {
      "id": 5,
      "start": 18.76,
      "end": 20.98,
      "text": "直接談大家 我覺得看",
      "speaker": null
    },
    {
      "id": 6,
      "start": 20.98,
      "end": 24.82,
      "text": "那也談一談",
      "speaker": null
    },
    {
      "id": 7,
      "start": 24.82,
      "end": 27.5,
      "text": "我覺得談這個明天不要人群",
      "speaker": null
    },
    {
      "id": 8,
      "start": 27.5,
      "end": 29.52,
      "text": "可以不用禁能那麼趣的地方",
      "speaker": null
    },
    {
      "id": 9,
      "start": 29.52,
      "end": 31.22,
      "text": "然後基本上就是",
      "speaker": null
    },
    {
      "id": 10,
      "start": 31.22,
      "end": 33.22,
      "text": "讓他什麼樣的神在的人群",
      "speaker": null
    },
    {
      "id": 11,
      "start": 33.22,
      "end": 34.52,
      "text": "然後都可以在這樣的",
      "speaker": null
    },
    {
      "id": 12,
      "start": 34.52,
      "end": 36.26,
      "text": "咱們的面子比較果爛",
      "speaker": null
    },
    {
      "id": 13,
      "start": 36.66,
      "end": 38.7,
      "text": "因為咱們這個手機現在基本上",
      "speaker": null
    },
    {
      "id": 14,
      "start": 38.7,
      "end": 40.46,
      "text": "壞觀設計的比較實際",
      "speaker": null
    },
    {
      "id": 15,
      "start": 40.46,
      "end": 41.86,
      "text": "所以我覺得其實",
      "speaker": null
    },
    {
      "id": 16,
      "start": 41.86,
      "end": 44.06,
      "text": "不用界定於這個老人",
      "speaker": null
    },
    {
      "id": 17,
      "start": 44.06,
      "end": 45.22,
      "text": "或者是有些人的事件",
      "speaker": null
    },
    {
      "id": 18,
      "start": 45.22,
      "end": 46.5,
      "text": "就是誇了大眼睛",
      "speaker": null
    },
    {
      "id": 19,
      "start": 46.5,
      "end": 47.02,
      "text": "對",
      "speaker": null
    },
    {
      "id": 20,
      "start": 47.02,
      "end": 48.98,
      "text": "這樣我覺得放在跟我一起",
      "speaker": null
    },
    {
      "id": 21,
      "start": 48.98,
      "end": 51.22,
      "text": "做什麼樣的人群都可以選擇嗎",
      "speaker": null
    },
    {
      "id": 22,
      "start": 51.22,
      "end": 52.22,
      "text": "好",
      "speaker": null
    },
    {
      "id": 23,
      "start": 52.22,
      "end": 54.82,
      "text": "我覺得是要要有這個問題",
      "speaker": null
    },
    {
      "id": 24,
      "start": 54.82,
      "end": 58.22,
      "text": "我覺得咱們的設計外觀還是很實際上",
      "speaker": null
    },
    {
      "id": 25,
      "start": 58.22,
      "end": 61.82,
      "text": "還是需要去設定一下",
      "speaker": null
    },
    {
      "id": 26,
      "start": 61.82,
      "end": 64.42,
      "text": "比較適合的年齡觀",
      "speaker": null
    },
    {
      "id": 27,
      "start": 64.42,
      "end": 65.42,
      "text": "對",
      "speaker": null
    },
    {
      "id": 28,
      "start": 65.42,
      "end": 66.78,
      "text": "有彩色的",
      "speaker": null
    },
    {
      "id": 29,
      "start": 66.78,
      "end": 67.98,
      "text": "有藍色的黃色",
      "speaker": null
    },
    {
      "id": 30,
      "start": 67.98,
      "end": 69.82,
      "text": "你老人人都不可能用這種東西",
      "speaker": null
    },
    {
      "id": 31,
      "start": 69.82,
      "end": 71.26,
      "text": "也可以合理合理合理合理",
      "speaker": null
    },
    {
      "id": 32,
      "start": 71.26,
      "end": 73.82,
      "text": "對 而且你現在設計的產品",
      "speaker": null
    },
    {
      "id": 33,
      "start": 73.82,
      "end": 75.06,
      "text": "主要推出的是",
      "speaker": null
    },
    {
      "id": 34,
      "start": 75.06,
      "end": 76.62,
      "text": "它有招向的功能",
      "speaker": null
    },
    {
      "id": 35,
      "start": 76.62,
      "end": 78.86,
      "text": "功能都跨適很",
      "speaker": null
    },
    {
      "id": 36,
      "start": 78.86,
      "end": 83.7,
      "text": "很好所以是還是適合年輕的人群",
      "speaker": null
    },
    {
      "id": 37,
      "start": 83.7,
      "end": 86.94,
      "text": "我感覺可以根據年齡和這種",
      "speaker": null
    },
    {
      "id": 38,
      "start": 86.94,
      "end": 90.3,
      "text": "就是不同的人士做下去分",
      "speaker": null
    },
    {
      "id": 39,
      "start": 90.3,
      "end": 93.38,
      "text": "我感覺我們可以做真的又是",
      "speaker": null
    },
    {
      "id": 40,
      "start": 93.38,
      "end": 97.58,
      "text": "18-45之類的中青年人群",
      "speaker": null
    },
    {
      "id": 41,
      "start": 97.58,
      "end": 99.38,
      "text": "我覺得這個選舉是主帝的",
      "speaker": null
    },
    {
      "id": 42,
      "start": 99.38,
      "end": 100.78,
      "text": "從這個特點的時候",
      "speaker": null
    },
    {
      "id": 43,
      "start": 100.78,
      "end": 103.62,
      "text": "就說年段靠了大眼睛",
      "speaker": null
    },
    {
      "id": 44,
      "start": 103.62,
      "end": 107.42,
      "text": "我覺得老年人也都很實際",
      "speaker": null
    },
    {
      "id": 45,
      "start": 107.42,
      "end": 108.78,
      "text": "現在老年出局",
      "speaker": null
    },
    {
      "id": 46,
      "start": 108.78,
      "end": 111.18,
      "text": "然後他基本上把自己裝進去",
      "speaker": null
    },
    {
      "id": 47,
      "start": 111.18,
      "end": 112.38,
      "text": "然後都是大粉",
      "speaker": null
    },
    {
      "id": 48,
      "start": 112.38,
      "end": 113.98,
      "text": "然後他很喜歡那個",
      "speaker": null
    },
    {
      "id": 49,
      "start": 113.98,
      "end": 115.78,
      "text": "我年輕年輕的男人",
      "speaker": null
    },
    {
      "id": 50,
      "start": 115.78,
      "end": 116.78,
      "text": "有年輕的男人",
      "speaker": null
    },
    {
      "id": 51,
      "start": 116.78,
      "end": 119.58,
      "text": "但是現在我覺得這個版本的話",
      "speaker": null
    },
    {
      "id": 52,
      "start": 119.58,
      "end": 120.98,
      "text": "它是不是老年人的",
      "speaker": null
    },
    {
      "id": 53,
      "start": 120.98,
      "end": 121.98,
      "text": "你有一些功能",
      "speaker": null
    },
    {
      "id": 54,
      "start": 121.98,
      "end": 122.98,
      "text": "像老年人的話",
      "speaker": null
    },
    {
      "id": 55,
      "start": 122.98,
      "end": 125.18,
      "text": "它需要很多的大伺體",
      "speaker": null
    },
    {
      "id": 56,
      "start": 125.18,
      "end": 128.58,
      "text": "或者是一些把剝剩的東西",
      "speaker": null
    },
    {
      "id": 57,
      "start": 128.58,
      "end": 129.78,
      "text": "老年人跟不一樣",
      "speaker": null
    },
    {
      "id": 58,
      "start": 129.78,
      "end": 133.78,
      "text": "對 它的那個規格也是不一樣的",
      "speaker": null
    },
    {
      "id": 59,
      "start": 133.78,
      "end": 136.38,
      "text": "對 有些手機裡邊的",
      "speaker": null
    },
    {
      "id": 60,
      "start": 136.38,
      "end": 139.89,
      "text": "很多人也算是了",
      "speaker": null
    },
    {
      "id": 61,
      "start": 139.89,
      "end": 142.89,
      "text": "而且我覺得現在老年人",
      "speaker": null
    },
    {
      "id": 62,
      "start": 142.89,
      "end": 144.09,
      "text": "也不是所有的老年人",
      "speaker": null
    },
    {
      "id": 63,
      "start": 144.09,
      "end": 145.69,
      "text": "都是那種眼睛",
      "speaker": null
    },
    {
      "id": 64,
      "start": 145.69,
      "end": 147.49,
      "text": "挖掘的這個情況",
      "speaker": null
    },
    {
      "id": 65,
      "start": 147.49,
      "end": 148.49,
      "text": "所以我覺得",
      "speaker": null
    },
    {
      "id": 66,
      "start": 148.49,
      "end": 150.29,
      "text": "就是不用買這個界線",
      "speaker": null
    },
    {
      "id": 67,
      "start": 150.29,
      "end": 151.49,
      "text": "弄得那麼分明",
      "speaker": null
    },
    {
      "id": 68,
      "start": 151.49,
      "end": 152.89,
      "text": "然後基本上能適合它",
      "speaker": null
    },
    {
      "id": 69,
      "start": 152.89,
      "end": 155.69,
      "text": "然後能去使用它的老年人",
      "speaker": null
    },
    {
      "id": 70,
      "start": 155.69,
      "end": 156.69,
      "text": "都還可以說",
      "speaker": null
    },
    {
      "id": 71,
      "start": 156.69,
      "end": 158.69,
      "text": "但是我覺得它是有這個性的好",
      "speaker": null
    },
    {
      "id": 72,
      "start": 158.69,
      "end": 160.69,
      "text": "你現在買手機的話",
      "speaker": null
    },
    {
      "id": 73,
      "start": 160.69,
      "end": 162.89,
      "text": "它故意都是說老年人自己去買",
      "speaker": null
    },
    {
      "id": 74,
      "start": 162.89,
      "end": 163.89,
      "text": "老年人跟美國",
      "speaker": null
    },
    {
      "id": 75,
      "start": 163.89,
      "end": 166.49,
      "text": "一般都是主女給家養去買",
      "speaker": null
    },
    {
      "id": 76,
      "start": 166.49,
      "end": 169.89,
      "text": "對 家裡面的一些功能是不斷的",
      "speaker": null
    },
    {
      "id": 77,
      "start": 169.89,
      "end": 171.89,
      "text": "對 我也不覺得",
      "speaker": null
    },
    {
      "id": 78,
      "start": 171.89,
      "end": 174.29,
      "text": "我感受我們可以根據就是",
      "speaker": null
    },
    {
      "id": 79,
      "start": 174.29,
      "end": 175.69,
      "text": "不同的人爭議所一下",
      "speaker": null
    },
    {
      "id": 80,
      "start": 175.69,
      "end": 176.49,
      "text": "差別設計",
      "speaker": null
    },
    {
      "id": 81,
      "start": 176.49,
      "end": 178.09,
      "text": "像如果老年人用的話",
      "speaker": null
    },
    {
      "id": 82,
      "start": 178.09,
      "end": 179.69,
      "text": "可以就是披著收益地點",
      "speaker": null
    },
    {
      "id": 83,
      "start": 179.69,
      "end": 181.69,
      "text": "就是自己或者聲音收益大眼",
      "speaker": null
    },
    {
      "id": 84,
      "start": 181.69,
      "end": 182.89,
      "text": "年輕人用的話",
      "speaker": null
    },
    {
      "id": 85,
      "start": 182.89,
      "end": 184.89,
      "text": "就可能顏色選擇性多點",
      "speaker": null
    },
    {
      "id": 86,
      "start": 184.89,
      "end": 186.09,
      "text": "披著高調這種",
      "speaker": null
    },
    {
      "id": 87,
      "start": 226.49,
      "end": 227.79,
      "text": "我感言可以現在通過",
      "speaker": null
    },
    {
      "id": 88,
      "start": 227.79,
      "end": 229.49,
      "text": "比如說我們的直播帶貨",
      "speaker": null
    },
    {
      "id": 89,
      "start": 229.49,
      "end": 233.09,
      "text": "然後不是麻煩就點上雙十一門",
      "speaker": null
    },
    {
      "id": 90,
      "start": 233.09,
      "end": 235.49,
      "text": "這種活動都可以多參與一下",
      "speaker": null
    },
    {
      "id": 91,
      "start": 235.49,
      "end": 237.09,
      "text": "就各大電商平台中的",
      "speaker": null
    },
    {
      "id": 92,
      "start": 237.09,
      "end": 240.09,
      "text": "天魔素寧 陀佛 平多多",
      "speaker": null
    },
    {
      "id": 93,
      "start": 240.09,
      "end": 244.96,
      "text": "我們前期主要是就是",
      "speaker": null
    },
    {
      "id": 94,
      "start": 244.96,
      "end": 247.56,
      "text": "價錢可以讓那些",
      "speaker": null
    },
    {
      "id": 95,
      "start": 247.56,
      "end": 249.16,
      "text": "多佔那些市場分額",
      "speaker": null
    },
    {
      "id": 96,
      "start": 249.16,
      "end": 250.36,
      "text": "等市場分額",
      "speaker": null
    },
    {
      "id": 97,
      "start": 250.36,
      "end": 252.36,
      "text": "慢慢做到之後就可以",
      "speaker": null
    },
    {
      "id": 98,
      "start": 252.36,
      "end": 275.5,
      "text": "就價錢收益高調一點點",
      "speaker": null
    },
    {
      "id": 99,
      "start": 276.3,
      "end": 278.9,
      "text": "你不要說他們現在的保留機會",
      "speaker": null
    },
    {
      "id": 100,
      "start": 278.9,
      "end": 280.3,
      "text": "對於五個房間",
      "speaker": null
    },
    {
      "id": 101,
      "start": 280.3,
      "end": 282.1,
      "text": "我也是一個方向",
      "speaker": null
    },
    {
      "id": 102,
      "start": 282.1,
      "end": 284.3,
      "text": "人被喊的時候也不能那個",
      "speaker": null
    },
    {
      "id": 103,
      "start": 284.3,
      "end": 285.3,
      "text": "我感受的地區這個",
      "speaker": null
    },
    {
      "id": 104,
      "start": 285.3,
      "end": 286.8,
      "text": "不太適合手機包含",
      "speaker": null
    },
    {
      "id": 105,
      "start": 286.8,
      "end": 289.3,
      "text": "手機包含一般就是有門店的弄",
      "speaker": null
    },
    {
      "id": 106,
      "start": 289.3,
      "end": 290.3,
      "text": "或者就是",
      "speaker": null
    }
  ]
}
