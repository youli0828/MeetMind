# Copy to .env; environment variables override this file. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Optional aliases; nonempty aliases win over legacy names in the same source.
# Process environment always takes precedence over .env, across both names.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
WHISPER_MODEL=
# Optional Hugging Face mirror for first-use Whisper downloads.
# HF_ENDPOINT=https://hf-mirror.com
# json_schema (default), json_object, or text for compatible providers.
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
# Reject longer transcripts explicitly; no silent truncation in M1.
MAX_TRANSCRIPT_CHARS=60000
# A model name downloads weights on first use; a local model directory also works.
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Empty means auto-detect. Examples: zh, en.
ASR_LANGUAGE=
# M2 server: embeddings use the same OpenAI-compatible service as chat.
EMBEDDING_MODEL=text-embedding-3-small
MEETMIND_DATA_DIR=outputs/server
# 1 = deterministic offline demonstration, 0 = configured model service.
MEETMIND_DEMO=0
